{
  "name": "redact-zero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-knowledge, 100% client-side ID & KYC document redactor with anti-fraud watermarking. No uploads, no telemetry, works offline.",
  "license": "MIT",
  "author": "jamamjadalone",
  "homepage": "https://jamamjadalone.is-a.dev/redact-zero/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamamjadalone/redact-zero.git"
  },
  "keywords": [
    "redaction",
    "privacy",
    "kyc",
    "pwa",
    "offline",
    "pdf",
    "canvas",
    "zero-knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@babel/helper-create-class-features-plugin": "7.29.7",
    "@babel/traverse": "7.29.8",
    "browserslist": "4.28.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 tests/repo-quality.test.mjs tests/smoke.test.mjs",
    "test:repo": "node --test tests/repo-quality.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
